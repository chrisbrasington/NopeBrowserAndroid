<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Render">

        <activity
            android:name="com.chrisincode.NopeBrowser.RenderActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="@string/app_name_short"
            android:launchMode="singleTop">

            <!--
                The link handler. No android:host, plus CATEGORY_BROWSABLE, is what
                makes Android treat this as a browser-class handler and offer it for
                every web link.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!--
                Appears in the app list. An app that handles every link on the phone but
                cannot be found anywhere is its own kind of confusing, so it is visible —
                it just has nothing to offer when opened this way. A MAIN intent carries
                no data, so RenderActivity shows the notice screen instead of a WebView.
                There is still no field to type a URL into.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
