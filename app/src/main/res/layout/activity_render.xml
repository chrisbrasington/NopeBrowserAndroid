<?xml version="1.0" encoding="utf-8"?>
<!--
    One WebView, edge to edge. No toolbar, no progress bar, no URL strip — so
    there is no leftover band of empty space where an address bar would sit.

    fitsSystemWindows keeps the page out from under the status bar without
    reserving anything else.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
