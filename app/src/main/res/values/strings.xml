<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">NopeBrowser (Minimal Web Renderer)</string>

    <!--
        The activity label, which is what the launcher and app list show. The full
        app_name reads too long in a list of icons; it still appears in Settings → Apps
        and in the link chooser.
    -->
    <string name="app_name_short">Nope Browser</string>

    <!-- Shown when the app is opened from the app list instead of by a link. -->
    <string name="notice_title">Nope, this is not a useful browser.</string>
    <string name="notice_body">It will render one page from a hyperlink with no navigation.</string>
    <string name="notice_countdown">Closing in %1$d…</string>
    <string name="notice_closing">Live your life</string>

    <!-- Shown when a link points at something in res/values/blocklist.xml. -->
    <string name="blocked_domain">Nope</string>

    <!-- First refusal per page, then the second one, which also ends the process. -->
    <string name="blocked_navigation">Nope, Navigation Blocked</string>
    <string name="blocked_navigation_final">Nope, I meant it!</string>
    <string name="blocked_download">Downloads disabled</string>
    <string name="blocked_scheme">Not a web link</string>
    <string name="blocked_certificate">Certificate rejected</string>
</resources>
